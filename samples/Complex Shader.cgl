shader complexShader {
    struct VSInput {
        float3 position @POSITION;
        float2 texCoord @TEXCOORD0;
        float3 normal @NORMAL;
    };

    struct VSOutput {
        float4 color @COLOR;
        float4 gl_Position @SV_POSITION;
    };

    struct PSInput {
        float4 color @COLOR;
        float2 texCoord @TEXCOORD0;
    };

    vertex {
        float3 calculateSpecular(float3 normal, float3 lightDir, float3 viewDir) {
            float3 reflectDir = reflect(-lightDir, normal);
            float spec = pow(max(dot(viewDir, reflectDir), 0.0), shininess);
            return spec * float3(1.0, 1.0, 1.0) * specularIntensity;
        }

        float3 applyNormalMapping(float3 normal, float3 mapNormal) {
            return normalize(normal * mapNormal);
        }

        VSOutput main(VSInput input) {
            VSOutput output;
            // Pass texture coordinates and normals to the fragment shader
            output.color.xy = input.texCoord;
            output.color.zw = input.normal;

            // Calculate normal map in the vertex shader
            float4 normalMapColor = tex2D(normalMap, input.texCoord);
            float3 mapNormal = normalize(normalMapColor.rgb * 2.0 - 1.0);
            float3 perturbedNormal = applyNormalMapping(input.normal, mapNormal);

            // Pass perturbed normal to the fragment shader
            output.color.rgb = perturbedNormal;
            output.color.a = 1.0; // Alpha channel
            output.gl_Position = float4(input.position, 1.0);
            return output;
        }
    }

    fragment {
        float4 main(PSInput input) @SV_TARGET {
            sampler2D diffuseTexture;
            sampler2D specularTexture;
            sampler2D normalMap;
            float3 lightPos;
            float3 viewPos;
            float3 ambientColor;
            float shininess;
            float specularIntensity;
            float4 fragColor;

            float4 diffuseColor = tex2D(diffuseTexture, input.texCoord);
            float4 specularColor = tex2D(specularTexture, input.texCoord);

            float3 perturbedNormal = normalize(input.color.rgb);
            float3 lightDir = normalize(lightPos - input.color.xyz);
            float3 viewDir = normalize(viewPos - input.color.xyz);

            // Ambient component
            float3 ambient = ambientColor;

            // Diffuse component
            float diff = max(dot(perturbedNormal, lightDir), 0.0);
            float3 diffuse = diff * diffuseColor.rgb;

            // Specular component
            float3 specular = calculateSpecular(perturbedNormal, lightDir, viewDir);

            float3 lighting = ambient + diffuse + specular;
            float4 color = float4(lighting, 1.0) * diffuseColor;

            fragColor = color;
            return fragColor;
        }
    }
}