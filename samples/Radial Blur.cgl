shader main {
    struct VSInput {
        vec3 position @POSITION;
        vec2 texCoord @TEXCOORD0;
    };

    struct VSOutput {
        vec3 positionOut @POSITION;
        vec2 texCoord @TEXCOORD0;
    };

    struct PSInput {
        vec2 texCoord @TEXCOORD0;
    };

    cbuffer ShaderUniforms { 
    vec2 center; 
    vec2 blurAmount; 
}

sampler2D texture; 


    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;
            output.texCoord = input.texCoord;
            return output;
        }
    }

    fragment {
        vec4 main(PSInput input) @SV_TARGET {
            vec2 dir = input.texCoord - center;
            vec4 color = vec4(0.0);
            for (int i = -4; i <= 4; i++) {
                color += texture.Sample(texture, input.texCoord + vec2(i) * dir * blurAmount / 10.0);
            }
            color /= 9.0;
            return color;
        }
    }
}