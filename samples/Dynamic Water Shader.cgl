shader main {
    struct VSInput {
        float2 position @POSITION;
    };

    struct VSOutput {
        float4 color @COLOR;
        float4 gl_Position @SV_POSITION;
    };

    struct PSInput {
        float4 color @COLOR;
    };

    vertex {
        float wave(float2 p, float time) {
            return sin(p.x * 10.0 + time * 2.0) * 0.1 + sin(p.y * 10.0 + time * 2.0) * 0.1;
        }

        VSOutput main(VSInput input) {
            VSOutput output;
            float2 uv = input.position;
            float waterHeight = wave(uv, iTime);
            float3 colorComputed = float3(0.0, 0.3, 0.8) * (1.0 + waterHeight);
            output.color = float4(colorComputed, 1.0);
            output.gl_Position = float4(input.position, 0.0, 1.0); // Assuming 2D position
            return output;
        }
    }

    fragment {
        float4 main(PSInput input) @SV_TARGET {
            float4 fragColor;
            fragColor = input.color;
            return fragColor;
        }
    }
}