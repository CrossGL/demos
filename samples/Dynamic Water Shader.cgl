shader main {
    struct VSInput {
        vec2 position @POSITION;
    };

    struct VSOutput {
        vec4 color @COLOR;
        vec4 gl_Position @SV_POSITION;
    };

    struct PSInput {
        vec4 color @COLOR;
    };

    vertex {
        vec2 wave(vec2 p, vec2 time) {
            return sin(p.x * 10.0 + time * 2.0) * 0.1 + sin(p.y * 10.0 + time * 2.0) * 0.1;
        }

        VSOutput main(VSInput input) {
            VSOutput output;
            vec2 uv = input.position;
            vec2 waterHeight = wave(uv, iTime);
            vec3 colorComputed = vec3(0.0, 0.3, 0.8) * (1.0 + waterHeight);
            output.color = vec4(colorComputed, 1.0);
            output.gl_Position = vec4(input.position, 0.0, 1.0); // Assuming 2D position
            return output;
        }
    }

    fragment {
        vec4 main(PSInput input) @SV_TARGET {
            vec4 fragColor;
            fragColor = input.color;
            return fragColor;
        }
    }
}