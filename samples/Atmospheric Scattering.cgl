shader main {

    struct VSInput {
        float3 position @POSITION;
    };

    struct VSOutput {
        float4 color @COLOR;
    };

    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;

            // Rayleigh scattering function
            float3 rayleighScattering(float theta) {
                return float3(0.5, 0.7, 1.0) * pow(max(0.0, 1.0 - theta * theta), 3.0);
            }

            // Compute the color based on Rayleigh scattering
            float theta = input.position.y;
            float3 colorComputed = rayleighScattering(theta);
            output.color = float4(colorComputed, 1.0);

            return output;
        }
    }

    struct PSInput {
        float4 color @COLOR;
    };

    struct PSOutput {
        float4 fragColor @SV_TARGET;
    };

    fragment {
        PSOutput main(PSInput input) {
            PSOutput output;

            // Pass the vertex shader color to the fragment shader output
            output.fragColor = input.color;

            return output;
        }
    }
}