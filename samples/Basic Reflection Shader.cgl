shader main {
    struct VSInput {
        vec3 position @POSITION;
        vec3 normal @NORMAL;
    };

    struct VSOutput {
        vec3 fragPosition @POSITION;
        vec3 fragNormal @NORMAL;
        vec4 gl_Position @SV_POSITION;
    };

    struct PSInput {
        vec3 fragPosition @POSITION;
        vec3 fragNormal @NORMAL;
    };

    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;
            output.fragPosition = input.position;
            output.fragNormal = input.normal;
            output.gl_Position = vec4(input.position, 1.0);
            return output;
        }
    }

    fragment {
        vec4 main(PSInput input) @SV_TARGET {
            sampler2D texture;
            samplerCube environmentMap;
            vec3 viewPos;
            vec4 fragColor;

            vec3 norm = normalize(input.fragNormal);
            vec3 viewDir = normalize(viewPos - input.fragPosition);
            vec3 reflectDir = reflect(-viewDir, norm);
            vec3 environmentColor = texCUBE(environmentMap, reflectDir).rgb;
            vec3 objectColor = tex2D(texture, input.fragPosition.xy).rgb;
            vec3 finalColor = lerp(objectColor, environmentColor, 0.5);
            fragColor = vec4(finalColor, 1.0);
            return fragColor;
        }
    }
}