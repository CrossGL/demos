shader main {
    struct VSInput {
        float3 position @POSITION;
        float3 normal @NORMAL;
    };

    struct VSOutput {
        float3 fragPosition @POSITION;
        float3 fragNormal @NORMAL;
        float4 gl_Position @SV_POSITION;
    };

    struct PSInput {
        float3 fragPosition @POSITION;
        float3 fragNormal @NORMAL;
    };

    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;
            output.fragPosition = input.position;
            output.fragNormal = input.normal;
            output.gl_Position = float4(input.position, 1.0);
            return output;
        }
    }

    fragment {
        float4 main(PSInput input) @SV_TARGET {
            sampler2D texture;
            samplerCube environmentMap;
            float3 viewPos;
            float4 fragColor;

            float3 norm = normalize(input.fragNormal);
            float3 viewDir = normalize(viewPos - input.fragPosition);
            float3 reflectDir = reflect(-viewDir, norm);
            float3 environmentColor = texCUBE(environmentMap, reflectDir).rgb;
            float3 objectColor = tex2D(texture, input.fragPosition.xy).rgb;
            float3 finalColor = lerp(objectColor, environmentColor, 0.5);
            fragColor = float4(finalColor, 1.0);
            return fragColor;
        }
    }
}