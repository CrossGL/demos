shader main {
    struct VSInput {
        vec3 position @POSITION;
        vec3 normal @NORMAL;
    };

    struct VSOutput {
        vec4 gl_Position @SV_POSITION;
        vec3 fragPosition @POSITION;
        vec3 fragNormal @NORMAL;
    };

    struct PSInput {
        vec3 fragPosition @POSITION;
        vec3 fragNormal @NORMAL;
    };

    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;
            output.fragPosition = input.position;
            output.fragNormal = input.normal;
            output.gl_Position = vec4(input.position, 1.0);
            return output;
        }
    }

    fragment {
        vec4 main(PSInput input) @SV_TARGET {
            vec3 lightPos;
            vec3 viewPos;
            vec4 fragColor;

            vec3 norm = normalize(input.fragNormal);
            vec3 lightDir = normalize(lightPos - input.fragPosition);
            vec2 diff = max(dot(norm, lightDir), 0.0);
            vec3 halfwayDir = normalize(lightDir + viewPos - input.fragPosition);
            vec2 spec = pow(max(dot(norm, halfwayDir), 0.0), 32.0);
            vec3 color = vec3(0.5, 0.5, 0.5) + diff + spec;
            fragColor = vec4(color, 1.0);
            return fragColor;
        }
    }
}