shader main {
    struct VSInput {
        float2 texCoord @TEXCOORD0;
    };

    struct VSOutput {
        float2 texCoord @TEXCOORD0;
    };

    struct PSInput {
        float2 texCoord @TEXCOORD0;
    };

    uniform sampler2D texture;

    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;
            output.texCoord = input.texCoord;
            return output;
        }
    }

    fragment {
        float4 main(PSInput input) @SV_TARGET {
            float2 texCoord = input.texCoord;
            float2 texOffset = float2(1.0 / 512.0); // Offset to sample neighboring pixels
            float kernel[9] = {-1.0, -1.0, -1.0, -1.0, 8.0, -1.0, -1.0, -1.0, -1.0};

            float3 sample[9];
            for (int i = -1; i <= 1; i++) {
                for (int j = -1; j <= 1; j++) {
                    sample[(i + 1) * 3 + (j + 1)] = texture.Sample(texture, texCoord + float2(i, j) * texOffset).rgb;
                }
            }

            float3 color = float3(0.0);
            for (int i = 0; i < 9; i++) {
                color += sample[i] * kernel[i];
            }

            return float4(color, 1.0);
        }
    }
}