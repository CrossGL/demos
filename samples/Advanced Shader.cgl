shader advancedShader {

    struct VSInput {
        float3 position @POSITION;
        float2 texCoord @TEXCOORD0;
    };

    struct VSOutput {
        float4 color @COLOR;
    };

    uniform float3 ambientColor;
    uniform float3 lightPos;
    uniform float3 viewPos;
    uniform float shininess;
    uniform sampler2D textureSampler;

    float3 calculateSpecular(float3 normal, float3 lightDir, float3 viewDir) {
        float3 reflectDir = reflect(-lightDir, normal);
        float spec = pow(max(dot(viewDir, reflectDir), 0.0), shininess);
        return spec * float3(1.0, 1.0, 1.0);  // White specular highlight
    }

    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;

            // Pass texture coordinates to the fragment shader
            output.color.xy = input.texCoord;

            // Calculate normal in the vertex shader
            float3 norm = normalize(cross(dFdx(input.position), dFdy(input.position)));
            float3 lightDir = normalize(lightPos - input.position);
            float3 viewDir = normalize(viewPos - input.position);

            // Ambient component
            float3 ambient = ambientColor;

            // Diffuse component
            float diff = max(dot(norm, lightDir), 0.0);
            float3 diffuse = diff * float3(1.0, 1.0, 1.0);  // White diffuse light

            // Specular component
            float3 specular = calculateSpecular(norm, lightDir, viewDir);

            // Combine lighting components
            float3 lighting = ambient + diffuse + specular;
            output.color.rgb = lighting;
            output.color.a = 1.0; // Alpha channel

            return output;
        }
    }

    fragment {
        float4 main(VSOutput input) @SV_TARGET {
            // Sample texture and apply lighting
            float4 texColor = texture(textureSampler, input.color.xy);
            return float4(input.color.rgb * texColor.rgb, 1.0);
        }
    }
}