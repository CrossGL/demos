shader main {
    struct VSInput {
        float2 texCoord @TEXCOORD0;
    };

    struct VSOutput {
        float4 gl_Position @SV_POSITION;
        float2 fragTexCoord @TEXCOORD0;
    };

    struct PSInput {
        float2 fragTexCoord @TEXCOORD0;
    };

    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;
            output.fragTexCoord = input.texCoord;
            output.gl_Position = float4(0.0, 0.0, 0.0, 1.0); // Placeholder for position
            return output;
        }
    }

    fragment {
        float4 main(PSInput input) @SV_TARGET {
            float3 topColor;
            float3 bottomColor;
            float4 fragColor;

            float3 color = lerp(bottomColor, topColor, input.fragTexCoord.y);
            fragColor = float4(color, 1.0);
            return fragColor;
        }
    }
}