shader main {
    struct VSInput {
        float3 position @POSITION;
    };

    struct VSOutput {
        float4 color @COLOR;
        float4 gl_Position @SV_POSITION;
    };

    struct PSInput {
        float4 color @COLOR;
    };

    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;
            // Pass through the position
            output.color = float4(input.position, 1.0);
            output.gl_Position = float4(input.position, 1.0);
            return output;
        }
    }

    fragment {
        float4 main(PSInput input) @SV_TARGET {
            float3 cameraPos;
            float3 fogColor;
            float fogDensity;
            float4 fragColor;

            float3 position = input.color.xyz; // Extract the position
            float distance = length(position - cameraPos);
            float fogFactor = exp(-pow(distance * fogDensity, 2.0));
            float3 finalColor = lerp(fogColor, float3(0.0, 0.5, 1.0), fogFactor);
            fragColor = float4(finalColor, 1.0);
            return fragColor;
        }
    }
}