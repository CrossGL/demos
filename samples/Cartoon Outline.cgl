shader main {
    struct VSInput {
        float2 texCoord @TEXCOORD0;
    };

    struct VSOutput {
        float4 gl_Position @SV_POSITION;
        float2 fragTexCoord @TEXCOORD0;
    };

    struct PSInput {
        float2 fragTexCoord @TEXCOORD0;
    };

    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;
            output.fragTexCoord = input.texCoord;
            output.gl_Position = float4(0.0, 0.0, 0.0, 1.0); // Placeholder for position
            return output;
        }
    }

    fragment {
        float4 main(PSInput input) @SV_TARGET {
            sampler2D texture;
            float outlineWidth;
            float4 fragColor;

            float2 texCoord = input.fragTexCoord;
            float4 color = tex2D(texture, texCoord);
            float4 north = tex2D(texture, texCoord + float2(0.0, outlineWidth));
            float4 south = tex2D(texture, texCoord - float2(0.0, outlineWidth));
            float4 east = tex2D(texture, texCoord + float2(outlineWidth, 0.0));
            float4 west = tex2D(texture, texCoord - float2(outlineWidth, 0.0));

            float edge = length((north + south + east + west) / 4.0 - color);
            if (edge > 0.1) {
                fragColor = float4(0.0, 0.0, 0.0, 1.0);
            } else {
                fragColor = color;
            }
            return fragColor;
        }
    }
}