shader main {
    struct VSInput {
        vec2 position @POSITION;
    };

    struct VSOutput {
        vec4 color @COLOR;
    };

    struct PSInput {
        vec4 color @COLOR;
    };

    vertex {
        vec2 noise(vec2 p) {
            return sin(p.x * 10.0) * cos(p.y * 10.0);
        }

        vec2 heightMap(vec2 p) {
            vec2 n = noise(p * 10.0);
            return p.y + n * 0.1;
        }

        VSOutput main(VSInput input) {
            VSOutput output;
            vec2 uv = input.position;
            vec2 height = heightMap(uv);
            vec3 colorComputed = vec3(0.5, 0.5, 0.5) * (1.0 - height * 0.5);
            output.color = vec4(colorComputed, 1.0);
            return output;
        }
    }

    fragment {
        vec4 main(PSInput input) @SV_TARGET {
            return input.color;
        }
    }
}