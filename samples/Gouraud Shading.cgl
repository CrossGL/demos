shader main {
    struct VSInput {
        float3 position @POSITION;
        float3 normal @NORMAL;
    };

    struct VSOutput {
        float4 gl_Position @SV_POSITION;
        float3 fragPosition @POSITION;
        float3 fragNormal @NORMAL;
    };

    struct PSInput {
        float3 fragPosition @POSITION;
        float3 fragNormal @NORMAL;
    };

    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;
            output.fragPosition = input.position;
            output.fragNormal = input.normal;
            output.gl_Position = float4(input.position, 1.0);
            return output;
        }
    }

    fragment {
        float4 main(PSInput input) @SV_TARGET {
            float3 lightPos;
            float4 fragColor;

            float3 norm = normalize(input.fragNormal);
            float3 lightDir = normalize(lightPos - input.fragPosition);
            float diff = max(dot(norm, lightDir), 0.0);
            float3 color = float3(0.5, 0.5, 0.5) + diff;
            fragColor = float4(color, 1.0);
            return fragColor;
        }
    }
}