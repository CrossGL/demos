shader main {
    struct VSInput {
        vec3 position @POSITION;
        vec3 normal @NORMAL;
    };

    struct VSOutput {
        vec3 position @POSITION;
        vec3 normal @NORMAL;
    };

    struct PSInput {
        vec3 position @POSITION;
        vec3 normal @NORMAL;
    };

   cbuffer ShaderUniforms { 
    vec3 lightPos; 
    vec3 viewPos; 
}


    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;
            output.position = input.position;
            output.normal = input.normal;
            return output;
        }
    }

    fragment {
        vec4 main(PSInput input) @SV_TARGET {
            vec3 norm = normalize(input.normal);
            vec3 lightDir = normalize(lightPos - input.position);
            vec2 diff = max(dot(norm, lightDir), 0.0);
            vec3 reflectDir = reflect(-lightDir, norm);
            vec3 viewDir = normalize(viewPos - input.position);
            vec2 spec = pow(max(dot(viewDir, reflectDir), 0.0), 32.0);
            vec3 color = vec3(0.5, 0.5, 0.5) + diff + spec;
            return vec4(color, 1.0);
        }
    }
}