shader main {
    struct VSInput {
        float3 position @POSITION;
        float3 normal @NORMAL;
    };

    struct VSOutput {
        float3 fragNormal @NORMAL;
        float3 fragPosition @POSITION;
    };

    struct PSInput {
        float3 fragNormal @NORMAL;
        float3 fragPosition @POSITION;
    };

    uniform float3 lightPos;
    uniform float3 lightColor;

    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;
            output.fragNormal = input.normal;
            output.fragPosition = input.position;
            gl_Position = float4(input.position, 1.0);
            return output;
        }
    }

    fragment {
        float4 main(PSInput input) @SV_TARGET {
            float3 norm = normalize(input.fragNormal);
            float3 lightDir = normalize(lightPos - input.fragPosition);
            float diff = max(dot(norm, lightDir), 0.0);
            float3 color = lightColor * diff;
            return float4(color, 1.0);
        }
    }
}