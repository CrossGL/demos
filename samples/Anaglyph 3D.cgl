shader main {

    struct VSInput {
        float2 texCoord @TEXCOORD0;
    };

    struct VSOutput {
        float4 fragColor @SV_TARGET;
    };

    uniform sampler2D texture;
    uniform float2 eyeOffset;

    fragment {
        VSOutput main(VSInput input) {
            VSOutput output;

            // Sample from the texture with eye offset
            float4 leftColor = texture(texture, input.texCoord - eyeOffset);
            float4 rightColor = texture(texture, input.texCoord + eyeOffset);

            // Combine the left and right colors for stereoscopic effect
            output.fragColor = float4(leftColor.r, rightColor.g, rightColor.b, 1.0);

            return output;
        }
    }
}