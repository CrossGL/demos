shader main {
    struct VSInput {
        float2 texCoord @TEXCOORD0;
    };

    struct VSOutput {
        float2 texCoord @TEXCOORD0;
    };

    struct PSInput {
        float2 texCoord @TEXCOORD0;
    };

    uniform sampler2D texture;
    uniform float2 lightPos;

    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;
            output.texCoord = input.texCoord;
            return output;
        }
    }

    fragment {
        float4 main(PSInput input) @SV_TARGET {
            float2 uv = input.texCoord;
            float4 color = texture.Sample(texture, uv);
            float2 dir = uv - lightPos;
            float dist = length(dir);
            float4 shaftColor = texture.Sample(texture, uv - dir * (1.0 - dist));
            return lerp(color, shaftColor, 0.5);
        }
    }
}