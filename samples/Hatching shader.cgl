shader main {
    struct VSInput {
        float2 texCoord @TEXCOORD0;
    };

    struct VSOutput {
        float4 gl_Position @SV_POSITION;
        float2 fragTexCoord @TEXCOORD0;
    };

    struct PSInput {
        float2 fragTexCoord @TEXCOORD0;
    };

    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;
            output.fragTexCoord = input.texCoord;
            output.gl_Position = float4(0.0, 0.0, 0.0, 1.0); // Placeholder for position
            return output;
        }
    }

    fragment {
        float4 main(PSInput input) @SV_TARGET {
            sampler2D texture;
            float threshold1;
            float threshold2;
            float threshold3;
            float4 fragColor;

            float4 color = tex2D(texture, input.fragTexCoord);
            float intensity = dot(color.rgb, float3(0.299, 0.587, 0.114));

            float3 hatching = float3(1.0);
            if (intensity < threshold1) hatching = float3(0.8);
            else if (intensity < threshold2) hatching = float3(0.6);
            else if (intensity < threshold3) hatching = float3(0.4);
            else hatching = float3(0.2);

            fragColor = float4(hatching, 1.0);
            return fragColor;
        }
    }
}