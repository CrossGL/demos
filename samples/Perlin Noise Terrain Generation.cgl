shader main {
    struct VSInput {
        float3 position @POSITION;
    };

    struct VSOutput {
        float4 color @COLOR;
    };

    struct PSInput {
        float4 color @COLOR;
    };

    vertex {
        float perlinNoise(float2 p) {
            return frac(sin(dot(p, float2(12.9898, 78.233))) * 43758.5453);
        }

        VSOutput main(VSInput input) {
            VSOutput output;
            float2 uv = input.position.xy * 10.0;
            float noise = perlinNoise(uv);
            float height = noise * 10.0;
            float3 computedColor = float3(height / 10.0, 1.0 - height / 10.0, 0.0);
            output.color = float4(computedColor, 1.0);
            return output;
        }
    }

    fragment {
        float4 main(PSInput input) @SV_TARGET {
            return input.color;
        }
    }
}