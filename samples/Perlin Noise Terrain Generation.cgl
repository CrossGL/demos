shader main {
    struct VSInput {
        vec3 position @POSITION;
    };

    struct VSOutput {
        vec4 color @COLOR;
    };

    struct PSInput {
        vec4 color @COLOR;
    };

    vertex {
        vec2 perlinNoise(vec2 p) {
            return frac(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);
        }

        VSOutput main(VSInput input) {
            VSOutput output;
            vec2 uv = input.position.xy * 10.0;
            vec2 noise = perlinNoise(uv);
            vec2 height = noise * 10.0;
            vec3 computedColor = vec3(height / 10.0, 1.0 - height / 10.0, 0.0);
            output.color = vec4(computedColor, 1.0);
            return output;
        }
    }

    fragment {
        vec4 main(PSInput input) @SV_TARGET {
            return input.color;
        }
    }
}