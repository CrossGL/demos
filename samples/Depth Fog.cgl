shader main {
    struct VSInput {
        float3 position @POSITION;
        float3 normal @NORMAL;
        float2 texCoord @TEXCOORD0;
    };

    struct VSOutput {
        float4 gl_Position @SV_POSITION;
        float3 fragPosition @POSITION;
        float2 fragTexCoord @TEXCOORD0;
    };

    struct PSInput {
        float3 fragPosition @POSITION;
        float2 fragTexCoord @TEXCOORD0;
    };

    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;
            output.fragPosition = input.position;
            output.fragTexCoord = input.texCoord;
            output.gl_Position = float4(input.position, 1.0);
            return output;
        }
    }

    fragment {
        float4 main(PSInput input) @SV_TARGET {
            sampler2D texture;
            float fogDensity;
            float3 fogColor;
            float4 fragColor;

            float3 baseColor = tex2D(texture, input.fragTexCoord).rgb;
            float depth = length(input.fragPosition);
            float fogFactor = exp(-fogDensity * depth);
            float3 finalColor = lerp(fogColor, baseColor, fogFactor);

            fragColor = float4(finalColor, 1.0);
            return fragColor;
        }
    }
}