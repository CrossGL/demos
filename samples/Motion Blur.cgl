shader main {
    struct VSInput {
        float2 texCoord @TEXCOORD0;
    };

    struct VSOutput {
        float4 color @COLOR;
    };

    struct PSInput {
        float4 color @COLOR;
    };

    uniform sampler2D texture;
    uniform float2 motionDirection;
    uniform float blurAmount;

    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;
            // Pass through the texture coordinate
            output.color = float4(input.texCoord, 0.0, 1.0);
            return output;
        }
    }

    fragment {
        float4 main(PSInput input) @SV_TARGET {
            float2 texCoord = input.color.xy; // Extract the texture coordinate
            float4 colorAccum = float4(0.0);
            for (int i = -4; i <= 4; i++) {
                colorAccum += texture.Sample(texture, texCoord + float(i) * motionDirection * blurAmount / 10.0);
            }
            colorAccum /= 9.0;
            return colorAccum;
        }
    }
}