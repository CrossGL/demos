shader main {
    struct VSInput {
        vec3 position @POSITION;
        vec3 normal @NORMAL; // Semantic for normal input
    };

    struct VSOutput {
        vec4 color @COLOR; // Output color
    };

    struct PSInput {
        vec4 color @COLOR; // Input color for the fragment shader
    };

    uniform vec3 lightPos;
    uniform vec3 colorLevels;

    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;
            output.color = vec4(input.position, 1.0); // Assign position to color
            // Note: The normal value should also be passed if needed for lighting calculations
            return output;
        }
    }

    fragment {
        float4 main(PSInput input) @SV_TARGET {
            vec3 position = input.color.xyz; // Extract the position
            vec3 normal = input.color.wyz;   // Extract the normal (assuming w holds a component of normal)

            vec3 norm = normalize(normal);
            vec3 lightDir = normalize(lightPos - position);
            float intensity = dot(norm, lightDir);
            vec3 fragColorValue = vec3(step(colorLevels, intensity));
            return float4(fragColorValue, 1.0);
        }
    }
}