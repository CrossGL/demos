shader main {
    struct VSInput {
        vec3 position @POSITION;
    };

    struct VSOutput {
        vec4 color @COLOR;
    };

    struct PSInput {
        vec4 color @COLOR;
    };

    vertex {
        vec2 waveFunction(vec2 p) {
            return sin(p.x * 10.0 + iTime) * 0.1;
        }

        VSOutput main(VSInput input) {
            VSOutput output;
            vec2 uv = input.position.xy;
            vec2 wave = waveFunction(uv);
            vec3 waterColor = vec3(0.0, 0.3, 0.8) * (1.0 - wave);
            output.color = vec4(waterColor, 1.0);
            return output;
        }
    }

    fragment {
        vec4 main(PSInput input) @SV_TARGET {
            return input.color;
        }
    }
}