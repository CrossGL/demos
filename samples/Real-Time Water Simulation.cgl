shader main {
    struct VSInput {
        float3 position @POSITION;
    };

    struct VSOutput {
        float4 color @COLOR;
    };

    struct PSInput {
        float4 color @COLOR;
    };

    vertex {
        float waveFunction(float2 p) {
            return sin(p.x * 10.0 + iTime) * 0.1;
        }

        VSOutput main(VSInput input) {
            VSOutput output;
            float2 uv = input.position.xy;
            float wave = waveFunction(uv);
            float3 waterColor = float3(0.0, 0.3, 0.8) * (1.0 - wave);
            output.color = float4(waterColor, 1.0);
            return output;
        }
    }

    fragment {
        float4 main(PSInput input) @SV_TARGET {
            return input.color;
        }
    }
}