shader main {
    struct VSInput {
        vec3 position @POSITION;
        vec3 normal @NORMAL;
    };

    struct VSOutput {
        vec3 positionOut @POSITION;
        vec3 normal @NORMAL;
    };

    struct PSInput {
        vec3 position @POSITION;
        vec3 normal @NORMAL;
    };

    cbuffer ShaderUniforms { 
    vec3 viewPos; 
    vec3 rimColor; 
    vec2 rimPower; 
}


    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;
            output.position = input.position;
            output.normal = input.normal;
            return output;
        }
    }

    fragment {
        vec4 main(PSInput input) @SV_TARGET {
            vec3 viewDir = normalize(viewPos - input.position);
            vec2 rim = pow(1.0 - max(dot(input.normal, viewDir), 0.0), rimPower);
            vec3 color = vec3(0.5, 0.5, 0.5) + rim * rimColor;
            return vec4(color, 1.0);
        }
    }
}