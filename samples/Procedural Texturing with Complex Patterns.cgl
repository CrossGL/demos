shader main {
    struct VSInput {
        float2 texCoord @TEXCOORD0;
    };

    struct VSOutput {
        float4 color @COLOR;
    };

    struct PSInput {
        float4 color @COLOR;
    };

    vertex {
        float marblePattern(float2 uv) {
            return 0.5 + 0.5 * sin(10.0 * uv.x + iTime);
        }

        VSOutput main(VSInput input) {
            VSOutput output;
            float3 colorComputed = float3(marblePattern(input.texCoord), 0.0, 0.0);
            output.color = float4(colorComputed, 1.0);
            return output;
        }
    }

    fragment {
        float4 main(PSInput input) @SV_TARGET {
            return input.color;
        }
    }
}