shader main {
    struct VSInput {
         vec3 position @POSITION; 
        vec2 texCoord @TEXCOORD0;
    };

    struct VSOutput {
        vec3 positionOut @POSITION;
        vec4 color @COLOR;
    };

    struct PSInput {
        vec4 color @COLOR;
    };

    vertex {
        vec2 marblePattern(vec2 uv) {
            return 0.5 + 0.5 * sin(10.0 * uv.x + iTime);
        }

        VSOutput main(VSInput input) {
            VSOutput output;
            vec3 colorComputed = vec3(marblePattern(input.texCoord), 0.0, 0.0);
            output.color = vec4(colorComputed, 1.0);
            return output;
        }
    }

    fragment {
        vec4 main(PSInput input) @SV_TARGET {
            return input.color;
        }
    }
}