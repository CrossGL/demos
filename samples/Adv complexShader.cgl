shader complexShader {

    struct VSInput {
        float3 position @POSITION;
        float2 texCoord @TEXCOORD0;
        float3 normal @NORMAL;
    };

    struct VSOutput {
        float4 position @SV_POSITION;
        float4 color @COLOR;
    };

    struct PSInput {
        float4 color @COLOR;
        float2 texCoord @TEXCOORD0;
    };

    uniform sampler2D normalMap;
    uniform sampler2D diffuseTexture;
    uniform sampler2D specularTexture;
    uniform float3 lightPos;
    uniform float3 viewPos;
    uniform float3 ambientColor;
    uniform float shininess;
    uniform float specularIntensity;
    uniform int iterations;

    float3 applyNormalMapping(float3 normal, float3 mapNormal) {
        return normalize(normal * mapNormal);
    }

    float3 calculateSpecular(float3 normal, float3 lightDir, float3 viewDir) {
        float3 reflectDir = reflect(-lightDir, normal);
        float spec = pow(max(dot(viewDir, reflectDir), 0.0), shininess);
        return spec * float3(1.0, 1.0, 1.0) * specularIntensity;
    }

    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;

            // Pass position to the fragment shader
            output.position = float4(input.position, 1.0);

            // Pass texture coordinates and normals to the fragment shader
            output.color.xy = input.texCoord;
            output.color.zw = input.normal;

            // Calculate normal map in the vertex shader
            float4 normalMapColor = texture(normalMap, input.texCoord);
            float3 mapNormal = normalize(normalMapColor.rgb * 2.0 - 1.0);
            float3 perturbedNormal = applyNormalMapping(input.normal, mapNormal);

            // Pass perturbed normal to the fragment shader
            output.color.rgb = perturbedNormal;
            output.color.a = 1.0; // Alpha channel

            return output;
        }
    }

    fragment {
        float4 main(PSInput input) @SV_TARGET {
            float4 diffuseColor = texture(diffuseTexture, input.texCoord);
            float4 specularColor = texture(specularTexture, input.texCoord);

            float3 perturbedNormal = normalize(input.color.rgb);
            float3 lightDir = normalize(lightPos - input.color.rgb);
            float3 viewDir = normalize(viewPos - input.color.rgb);

            // Ambient component
            float3 ambient = ambientColor;

            // Diffuse component
            float diff = max(dot(perturbedNormal, lightDir), 0.0);
            float3 diffuse = diff * diffuseColor.rgb;

            // Specular component
            float3 specular = calculateSpecular(perturbedNormal, lightDir, viewDir);

            // Loop to modify lighting based on iterations
            float3 lighting = ambient + diffuse + specular;
            for (int i = 0; i < iterations; i++) {
                lighting *= 0.9;
            }

            // Ternary operator to conditionally modify color
            float4 outputColor = (diff > 0.5) ? float4(lighting, 1.0) * diffuseColor : float4(lighting * 0.5, 1.0) * diffuseColor;

            return outputColor;
        }
    }
}