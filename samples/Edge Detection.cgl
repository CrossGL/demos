shader main {
    struct VSInput {
        vec3 position @POSITION;
        vec2 texCoord @TEXCOORD0;
    };

    struct VSOutput {
        vec4 color @COLOR;
        vec4 gl_Position @SV_POSITION;
    };

    struct PSInput {
        vec4 color @COLOR;
    };

    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;
            // Pass through the texture coordinate
            output.color = vec4(input.texCoord, 0.0, 1.0);
            output.gl_Position = vec4(0.0, 0.0, 0.0, 1.0); // Placeholder for position
            return output;
        }
    }

    fragment {
        vec4 main(PSInput input) @SV_TARGET {
            sampler2D texture;
            vec4 fragColor;

            vec2 texCoord = input.color.xy; // Extract the texture coordinate
            vec2 offset = vec2(1.0 / 512.0, 1.0 / 512.0);
            vec3 color = tex2D(texture, texCoord).rgb;
            vec3 colorRight = tex2D(texture, texCoord + vec2(offset.x, 0.0)).rgb;
            vec3 colorUp = tex2D(texture, texCoord + vec2(0.0, offset.y)).rgb;

            vec3 edge = abs(color - colorRight) + abs(color - colorUp);
            fragColor = vec4(edge, 1.0);
            return fragColor;
        }
    }
}