shader main {
    struct VSInput {
        float2 texCoord @TEXCOORD0;
    };

    struct VSOutput {
        float4 color @COLOR;
        float4 gl_Position @SV_POSITION;
    };

    struct PSInput {
        float4 color @COLOR;
    };

    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;
            // Pass through the texture coordinate
            output.color = float4(input.texCoord, 0.0, 1.0);
            output.gl_Position = float4(0.0, 0.0, 0.0, 1.0); // Placeholder for position
            return output;
        }
    }

    fragment {
        float4 main(PSInput input) @SV_TARGET {
            sampler2D texture;
            float4 fragColor;

            float2 texCoord = input.color.xy; // Extract the texture coordinate
            float2 offset = float2(1.0 / 512.0, 1.0 / 512.0);
            float3 color = tex2D(texture, texCoord).rgb;
            float3 colorRight = tex2D(texture, texCoord + float2(offset.x, 0.0)).rgb;
            float3 colorUp = tex2D(texture, texCoord + float2(0.0, offset.y)).rgb;

            float3 edge = abs(color - colorRight) + abs(color - colorUp);
            fragColor = float4(edge, 1.0);
            return fragColor;
        }
    }
}