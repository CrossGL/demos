shader main {
    struct VSInput {
        float2 texCoord @TEXCOORD0;
    };

    struct VSOutput {
        float4 color @COLOR;
    };

    struct PSInput {
        float4 color @COLOR;
    };

    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;
            output.color = float4(input.texCoord, 0.0, 1.0);
            return output;
        }
    }

    fragment {
        float4 main(PSInput input) @SV_TARGET {
            sampler2D texture;
            float threshold;
            float4 fragColor;

            float2 texCoord = input.color.xy; // Extract the texture coordinate
            float4 texColor = tex2D(texture, texCoord);
            float4 bloom = max(texColor - threshold, 0.0);
            fragColor = texColor + bloom;
            return fragColor;
        }
    }
}