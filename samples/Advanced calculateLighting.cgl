shader complexShader {

    struct VSInput {
        float3 position @POSITION;
        float2 texCoord @TEXCOORD0;
    };

    struct VSOutput {
        float4 color @COLOR;
    };

    uniform float4x4 modelMatrix;
    uniform float time;
    uniform sampler2D textureSampler;

    float3 calculateLighting(float3 normal, float3 lightDir, float3 viewDir) {
        float ambientStrength = 0.1;
        float3 ambient = ambientStrength * float3(1.0, 1.0, 1.0); // Light color

        float diff = max(dot(normal, lightDir), 0.0);
        float3 diffuse = diff * float3(1.0, 1.0, 1.0); // Light color

        float specularStrength = 0.5;
        float3 reflectDir = reflect(-lightDir, normal);
        float spec = pow(max(dot(viewDir, reflectDir), 0.0), 32.0);
        float3 specular = specularStrength * spec * float3(1.0, 1.0, 1.0); // Light color

        return ambient + diffuse + specular;
    }

    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;

            // Pass texture coordinates to the fragment shader
            output.color.xy = input.texCoord;

            // Calculate normal in the vertex shader
            float3 normal = normalize(cross(dFdx(input.position), dFdy(input.position)));
            float3 lightDir = normalize(float3(1.0, 1.0, 1.0));
            float3 viewDir = normalize(-input.position);

            float3 lighting = calculateLighting(normal, lightDir, viewDir);
            output.color.rgb = lighting;
            output.color.a = 1.0; // Alpha channel

            return output;
        }
    }

    fragment {
        float4 main(VSOutput input) @SV_TARGET {
            float4 texColor = texture(textureSampler, input.color.xy);
            return float4(input.color.rgb * texColor.rgb, 1.0);
        }
    }
}