shader main {
    struct VSInput {
        float3 position @POSITION;
    };

    struct VSOutput {
        float4 color @COLOR;
        float4 gl_Position @SV_POSITION;
    };

    struct PSInput {
        float4 color @COLOR;
    };

    vertex {
        float3 dayNightColor(float timeOfDay) {
            return lerp(float3(0.0, 0.5, 1.0), float3(0.0, 0.0, 0.2), timeOfDay);
        }

        VSOutput main(VSInput input) {
            VSOutput output;
            float timeOfDay = fmod(iTime / 24.0, 1.0);
            float3 colorComputed = dayNightColor(timeOfDay);
            output.color = float4(colorComputed, 1.0);
            output.gl_Position = float4(input.position, 1.0);
            return output;
        }
    }

    fragment {
        float4 main(PSInput input) @SV_TARGET {
            float4 fragColor;
            fragColor = input.color;
            return fragColor;
        }
    }
}