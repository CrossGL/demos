shader main {
    struct VSInput {
        float2 texCoord @TEXCOORD0;
    };

    struct VSOutput {
        float2 texCoord @TEXCOORD0;
    };

    struct PSInput {
        float2 texCoord @TEXCOORD0;
    };

    uniform sampler2D texture;
    uniform float strength;

    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;
            output.texCoord = input.texCoord;
            return output;
        }
    }

    fragment {
        float4 main(PSInput input) @SV_TARGET {
            float2 uv = input.texCoord * 2.0 - 1.0; // Convert texCoord from [0, 1] to [-1, 1] range
            float len = length(uv); // Compute the distance from the center
            if (len < 1.0) {
                uv = uv * (1.0 + strength * len * len); // Apply distortion based on distance
            }
            uv = uv * 0.5 + 0.5; // Convert back to [0, 1] range
            return texture.Sample(texture, uv); // Sample the texture at the distorted coordinates
        }
    }
}