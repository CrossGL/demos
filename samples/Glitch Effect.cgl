shader main {
    struct VSInput {
        vec3 position @POSITION;
        vec2 texCoord @TEXCOORD0;
    };

    struct VSOutput {
        vec4 gl_Position @SV_POSITION;
        vec2 fragTexCoord @TEXCOORD0;
    };

    struct PSInput {
        vec2 fragTexCoord @TEXCOORD0;
    };

    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;
            output.fragTexCoord = input.texCoord;
            output.gl_Position = vec4(0.0, 0.0, 0.0, 1.0); // Placeholder for position
            return output;
        }
    }

    fragment {
        vec4 main(PSInput input) @SV_TARGET {
            sampler2D texture;
            vec2 time;
            vec4 fragColor;

            vec2 uv = input.fragTexCoord;
            if (fract(time * 10.0) < 0.5) {
                uv.x += sin(input.fragTexCoord.y * 10.0) * 0.1;
            }
            vec4 color = tex2D(texture, uv);
            fragColor = color;
            return fragColor;
        }
    }
}