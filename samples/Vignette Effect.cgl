shader main {
    struct PSInput {
        vec2 texCoord @TEXCOORD0; // Input texture coordinate
    };

    output vec4 fragColor;

    cbuffer ShaderUniforms { 
    vec2 radius; 
    vec2 softness; 
}

sampler2D texture; 


    fragment {
        vec4 main(PSInput input) @SV_TARGET {
            // Sample the texture at the input texture coordinates
            vec4 color = texture(texture, input.texCoord);
            
            // Calculate the distance from the center (0.5, 0.5)
            vec2 dist = distance(input.texCoord, vec2(0.5));
            
            // Compute the vignette effect using smoothstep
            vec2 vignette = smoothstep(radius, radius - softness, dist);
            
            // Set the fragment color applying the vignette effect
            return vec4(color.rgb * vignette, 1.0);
        }
    }
}