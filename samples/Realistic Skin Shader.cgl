shader main {
    struct VSInput {
        vec3 position @POSITION;
    };

    struct VSOutput {
        vec4 color @COLOR;
    };

    struct PSInput {
        vec4 color @COLOR;
    };

    vertex {
        vec2 subsurfaceScattering(vec3 pos) {
            return exp(-length(pos) * 2.0);
        }

        VSOutput main(VSInput input) {
            VSOutput output;
            vec3 baseColor = vec3(1.0, 0.8, 0.6);
            vec2 sss = subsurfaceScattering(input.position);
            vec3 colorComputed = baseColor * sss;
            output.color = vec4(colorComputed, 1.0);
            return output;
        }
    }

    fragment {
        vec4 main(PSInput input) @SV_TARGET {
            return input.color;
        }
    }
}