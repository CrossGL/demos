shader main {
    struct VSInput {
        float3 position @POSITION;
    };

    struct VSOutput {
        float4 color @COLOR;
    };

    struct PSInput {
        float4 color @COLOR;
    };

    vertex {
        float subsurfaceScattering(float3 pos) {
            return exp(-length(pos) * 2.0);
        }

        VSOutput main(VSInput input) {
            VSOutput output;
            float3 baseColor = float3(1.0, 0.8, 0.6);
            float sss = subsurfaceScattering(input.position);
            float3 colorComputed = baseColor * sss;
            output.color = float4(colorComputed, 1.0);
            return output;
        }
    }

    fragment {
        float4 main(PSInput input) @SV_TARGET {
            return input.color;
        }
    }
}