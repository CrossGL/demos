shader main {
    struct VSInput {
        float2 texCoord @TEXCOORD0;
    };

    struct VSOutput {
        float4 gl_Position @SV_POSITION;
        float2 fragTexCoord @TEXCOORD0;
    };

    struct PSInput {
        float2 fragTexCoord @TEXCOORD0;
    };

    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;
            output.fragTexCoord = input.texCoord;
            output.gl_Position = float4(0.0, 0.0, 0.0, 1.0); // Placeholder for position
            return output;
        }
    }

    fragment {
        float4 main(PSInput input) @SV_TARGET {
            sampler2D texture;
            float dotSize;
            float4 fragColor;

            // Scale texture coordinates by dotSize
            float2 uv = input.fragTexCoord * dotSize;

            // Calculate angle and radius for the dot pattern
            float angle = fmod(uv.x + uv.y, 2.0) * 3.14159265;
            float radius = length(frac(uv) - float2(0.5));

            // Sample color from texture
            float4 color = tex2D(texture, input.fragTexCoord);

            // Calculate intensity based on luminance
            float intensity = dot(color.rgb, float3(0.299, 0.587, 0.114));

            // Compute dot pattern using smoothstep for edge softness
            float dot = smoothstep(0.4, 0.5, sin(angle) * 0.5 + radius);

            // Set fragment color with dot pattern applied
            fragColor = float4(float3(dot * intensity), 1.0);
            return fragColor;
        }
    }
}