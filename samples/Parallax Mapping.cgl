shader main {
    struct VSInput {
        float2 texCoord @TEXCOORD0;
    };

    struct VSOutput {
        float2 texCoordOut @TEXCOORD0;
    };

    struct PSInput {
        float2 texCoordOut @TEXCOORD0;
    };

    uniform sampler2D texture;
    uniform sampler2D heightMap;
    uniform float2 viewDir;

    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;
            output.texCoordOut = input.texCoord;
            return output;
        }
    }

    fragment {
        float4 main(PSInput input) @SV_TARGET {
            float2 texCoordOut = input.texCoordOut;
            float height = texture.Sample(heightMap, texCoordOut).r;
            float2 offset = height * viewDir;
            float4 color = texture.Sample(texture, texCoordOut + offset);
            return float4(color.rgb, 1.0);
        }
    }
}