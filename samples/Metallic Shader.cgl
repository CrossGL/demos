shader main {
    struct VSInput {
        float3 position @POSITION;
        float3 normal @NORMAL;
    };

    struct VSOutput {
        float4 color @COLOR;
    };

    struct PSInput {
        float4 color @COLOR;
    };

    uniform float3 lightPos;
    uniform float3 viewPos;
    uniform float metallic;

    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;

            float3 norm = normalize(input.normal);
            float3 lightDir = normalize(lightPos - input.position);
            float3 viewDir = normalize(viewPos - input.position);

            float ambient = 0.1;
            float diff = max(dot(norm, lightDir), 0.0);
            float3 reflectDir = reflect(-lightDir, norm);
            float spec = pow(max(dot(viewDir, reflectDir), 0.0), 32.0);
            float3 lighting = ambient + diff + metallic * spec;

            output.color.rgb = float3(1.0, 0.8, 0.6) * lighting;
            output.color.a = 1.0; // Alpha channel

            return output;
        }
    }

    fragment {
        float4 main(PSInput input) @SV_TARGET {
            return input.color;
        }
    }
}