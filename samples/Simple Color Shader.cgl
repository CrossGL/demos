shader main {
    struct VSInput {
        float3 position @POSITION;
    };

    struct VSOutput {
        float4 color @COLOR;
    };

    struct PSInput {
        float4 color @COLOR;
    };

    vertex {
        VSOutput main(VSInput input) {
            VSOutput output;
            output.color = float4(input.position, 1.0);
            return output;
        }
    }

    fragment {
        float4 main(PSInput input) @SV_TARGET {
            return input.color;
        }
    }
}