shader main {
    struct PSInput {
        vec2 texCoord @TEXCOORD0; // Input texture coordinate
    };

    output vec4 fragColor;

   cbuffer ShaderUniforms { 
    vec2 time; 
}

sampler2D texture; 


    fragment {
        vec4 main(PSInput input) @SV_TARGET {
            // Compute the UV coordinates with a time-based offset
            vec2 uv = input.texCoord + vec2(sin(input.texCoord.y * 10.0 + time) * 0.01,
                                             cos(input.texCoord.x * 10.0 + time) * 0.01);
            
            // Sample the texture at the modified UV coordinates
            vec4 color = texture(texture, uv);
            
            // Set the fragment color
            return vec4(color.rgb, 1.0);
        }
    }
}